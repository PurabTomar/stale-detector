# Routing mode toggle:
#   USE_BIFROST=true  -> route via your Bifrost AI Gateway (local or hosted)
#   USE_BIFROST=false -> call Google Gemini's OpenAI-compatible endpoint directly
#                        (recommended for Streamlit Community Cloud where no local Bifrost runs)
USE_BIFROST=true

# ------------------------------------------------------------------------------
# Option A: Bifrost Gateway configuration (USE_BIFROST=true)
# ------------------------------------------------------------------------------
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=bifrost-local
LLM_MODEL=gemini/gemini-2.5-flash

# Optional task-based routing (both default to LLM_MODEL when unset):
#   LLM_MODEL_EXTRACT -> fast/low-cost model for claim extraction
#   LLM_MODEL_JUDGE   -> stronger model for freshness judging
LLM_MODEL_EXTRACT=gemini/gemini-2.5-flash-lite
LLM_MODEL_JUDGE=openai/gpt-4o-mini
# Optional explicit second judge for Dual-judge mode (otherwise picks a cross-provider fallback):
# LLM_MODEL_JUDGE_2=anthropic/claude-3-5-sonnet-20241022

# Cross-provider fallback list in canonical Bifrost `provider/model` format
# (sent via native Bifrost extra_body={"fallbacks": [...]}):
# Examples: openai/gpt-4o-mini, anthropic/claude-3-5-sonnet-20241022, groq/llama-3.3-70b-versatile, gemini/gemini-2.5-flash
LLM_MODEL_FALLBACKS=openai/gpt-4o-mini,anthropic/claude-3-5-sonnet-20241022,groq/llama-3.3-70b-versatile

# Optional Bifrost Virtual Key sent as x-bf-vk header (ensure allowed providers include all configured providers):
# LLM_VIRTUAL_KEY=bf_vk_your_virtual_key

# ------------------------------------------------------------------------------
# Option B: Direct Gemini / Streamlit Community Cloud (USE_BIFROST=false)
# ------------------------------------------------------------------------------
# Set USE_BIFROST=false and provide your Google Gemini API key (LLM_API_KEY or GEMINI_API_KEY).
# Base URL automatically targets https://generativelanguage.googleapis.com/v1beta/openai/
# USE_BIFROST=false
# LLM_API_KEY=your-gemini-api-key-here
# LLM_MODEL=gemini-2.5-flash
# LLM_MODEL_FALLBACKS=gemini-2.5-flash-lite,gemini-2.0-flash

# ------------------------------------------------------------------------------
# Tavily Search & Extract API key (https://tavily.com)
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your-tavily-api-key-here

# Optional JSON override/extension for primary-first entity domain routing:
# ENTITY_DOMAIN_MAP={"myproduct": ["myproduct.com", "docs.myproduct.com"]}
