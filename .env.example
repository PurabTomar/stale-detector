# LLM configuration (OpenAI-compatible endpoint, e.g., OpenAI or a Bifrost gateway)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o-mini
# Optional comma-separated fallback models used on 429, 500, 503, or 404 errors:
LLM_MODEL_FALLBACKS=gpt-4o,gpt-4.1-mini

# Example for pointing at a local Bifrost gateway without changing code:
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_API_KEY=bifrost-local
# LLM_MODEL=openai/gpt-4o-mini
# LLM_MODEL_FALLBACKS=anthropic/claude-3-5-sonnet-20241022,gemini/gemini-2.5-flash

# Tavily Search API key (https://tavily.com)
TAVILY_API_KEY=your-tavily-api-key-here
