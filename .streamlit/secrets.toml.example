# Copy these keys into Streamlit Community Cloud:
# App dashboard -> Settings -> Secrets
# (Or locally into `.streamlit/secrets.toml`, which is git-ignored.)

USE_BIFROST = "false"
LLM_API_KEY = "your-google-gemini-api-key"
LLM_MODEL = "gemini-2.5-flash"
LLM_MODEL_EXTRACT = "gemini-2.5-flash-lite"
LLM_MODEL_JUDGE = "gemini-2.5-flash"
LLM_MODEL_FALLBACKS = "gemini-2.5-flash-lite,gemini-2.0-flash"
TAVILY_API_KEY = "tvly-your-tavily-api-key"
